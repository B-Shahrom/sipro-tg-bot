# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC...
# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Group where managers receive orders, service requests and live chats.
# Add the bot to the group and send /id there. Looks like -1001234567890.
# (First run: leave the placeholder, start the bot, then use /id to get the real values.)
MANAGER_CHAT_ID=-1001234567890
# NUMERIC Telegram user ids (not @usernames) allowed to use /import, /export, /stats, /reload.
# Send /id to the bot in private (or message @userinfobot). Comma separated.
ADMIN_IDS=

STORE_NAME=SIPRO
CURRENCY=₽
# Customer languages, comma separated; first is default. Only "ru" texts exist today.
LANGUAGES=ru

# Claude settings
CLAUDE_MODEL=claude-opus-5
# low | medium | high — higher is smarter but slower and more expensive
CLAUDE_EFFORT=medium
# Retry declined requests on a fallback model (Claude API only)
CLAUDE_FALLBACKS=true
HISTORY_LIMIT=30
AI_DAILY_LIMIT=150
